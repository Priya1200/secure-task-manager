pipeline {
  agent any
  environment {
    VAULT_ADDR = 'http://127.0.0.1:8200'
    KUBECONFIG = '/var/lib/jenkins/.kube/config'
  }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Fetch secrets from Vault') {
      steps {
        withCredentials([string(credentialsId: 'vault-token', variable: 'VAULT_TOKEN')]) {
          sh 'bash secrets/deploy-secrets.sh'
        }
      }
    }
    stage('Deploy') {
      steps {
        sh '''
          kubectl apply -f secrets/deployment.yaml
          kubectl -n secrets-demo rollout restart deployment/secrets-demo
          kubectl -n secrets-demo rollout status deployment/secrets-demo --timeout=120s
        '''
      }
    }
  }
}
